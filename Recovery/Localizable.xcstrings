    "So fern der Morgen ist vom Abend, lässt er unsre Übertretungen von uns sein." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So fern der Morgen ist vom Abend, lässt er unsre Übertretungen von uns sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As far as the east is from the west, so far has he removed our transgressions from us."
          }
        }
      }
    },
    "So funktioniert’s" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So funktioniert’s"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How it works"
          }
        }
      }
    },
    "So seid nun Gott untertänig. Widersteht dem Teufel, so flieht er von euch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So seid nun Gott untertänig. Widersteht dem Teufel, so flieht er von euch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be subject therefore to God. Resist the devil, and he will flee from you."
          }
        }
      }
    },
