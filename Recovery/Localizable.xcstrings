    "Gott ist treu, der euch nicht versuchen lässt über eure Kraft, sondern macht, dass die Versuchung so ein Ende nimmt, dass ihr's ertragen könnt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gott ist treu, der euch nicht versuchen lässt über eure Kraft, sondern macht, dass die Versuchung so ein Ende nimmt, dass ihr's ertragen könnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "God is faithful, who will not allow you to be tempted above what you are able, but with the temptation will also make the way of escape, that you may be able to endure it."
          }
        }
      }
    },
