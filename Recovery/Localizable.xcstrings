      }
    },
    "Lass uns kurz festhalten, was passiert ist. Das hilft dir, deine Muster besser zu verstehen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass uns kurz festhalten, was passiert ist. Das hilft dir, deine Muster besser zu verstehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let's briefly note what happened. It helps you understand your patterns better."
          }
        }
      }
    },
    "Lasst uns aber Gutes tun und nicht müde werden; denn zu seiner Zeit werden wir auch ernten, wenn wir nicht nachlassen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
