          "stringUnit" : {
            "state" : "translated",
            "value" : "Self-compassion after a setback increases the likelihood of sticking with it."
          }
        }
      }
    },
    "Selig ist der Mann, der die Anfechtung erduldet; denn nachdem er bewährt ist, wird er die Krone des Lebens empfangen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selig ist der Mann, der die Anfechtung erduldet; denn nachdem er bewährt ist, wird er die Krone des Lebens empfangen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blessed is the man who endures temptation; for when he has been approved, he will receive the crown of life."
          }
        }
      }
    },
